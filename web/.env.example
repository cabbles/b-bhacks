# Optional overrides; by default addresses and URLs come from shared/deployments.json.
# Without a referee URL the referee is served from fixtures; without a pool address, so are the contracts (mock mode).
NEXT_PUBLIC_REFEREE_URL=
# Optional: public site URL for task invite links (defaults to shared/deployments.json, then window.location.origin)
NEXT_PUBLIC_WEB_URL=
# Base Sepolia RPC the browser reads from (defaults to https://sepolia.base.org, which is rate-limited).
# A keyed RPC URL is visible to every visitor: restrict the key to your site's domain in the provider's dashboard.
NEXT_PUBLIC_RPC_URL=
# Force fixtures for the contracts and the referee (rehearsal, screenshots)
NEXT_PUBLIC_MOCK=
