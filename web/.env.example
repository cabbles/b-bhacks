# Optional overrides; by default URLs come from shared/deployments.json.
# A service without a URL is served from shared/fixtures (mock mode).
NEXT_PUBLIC_RELAYER_URL=
NEXT_PUBLIC_REFEREE_URL=
# Optional: public site URL for task invite links (defaults to shared/deployments.json, then window.location.origin)
NEXT_PUBLIC_WEB_URL=
# Optional: Base Sepolia RPC for reading token decimals (defaults to https://sepolia.base.org)
NEXT_PUBLIC_RPC_URL=
# Force fixtures for both services (rehearsal, screenshots)
NEXT_PUBLIC_MOCK=
