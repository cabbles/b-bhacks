{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "criteria.schema.json",
  "title": "Criteria (PLAN.md 4.2)",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "type", "staker", "goal_text", "window", "nonce", "params"],
  "properties": {
    "version": { "const": 1 },
    "type": { "enum": ["github_commits", "url_live", "canvas_submission"] },
    "staker": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
    "goal_text": { "type": "string", "minLength": 1 },
    "window": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "deadline"],
      "properties": {
        "start": { "type": "string", "format": "date-time" },
        "deadline": { "type": "string", "format": "date-time" }
      }
    },
    "nonce": { "type": "string", "pattern": "^ref-[0-9a-f]{8}$" },
    "params": { "type": "object" }
  },
  "allOf": [
    {
      "if": { "properties": { "type": { "const": "github_commits" } } },
      "then": {
        "properties": {
          "params": {
            "type": "object",
            "additionalProperties": false,
            "required": ["repo", "branch", "min_commits"],
            "properties": {
              "repo": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" },
              "branch": { "type": "string", "minLength": 1 },
              "min_commits": { "type": "integer", "minimum": 1 },
              "github_login": { "type": "string", "pattern": "^[A-Za-z0-9-]{1,39}$" }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "url_live" } } },
      "then": {
        "properties": {
          "params": {
            "type": "object",
            "additionalProperties": false,
            "required": ["url", "must_contain"],
            "properties": {
              "url": { "type": "string", "pattern": "^https://" },
              "must_contain": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "canvas_submission" } } },
      "then": {
        "properties": {
          "params": {
            "type": "object",
            "additionalProperties": false,
            "required": ["course_id", "assignment_id", "min_bytes"],
            "properties": {
              "course_id": { "type": "integer" },
              "assignment_id": { "type": "integer" },
              "min_bytes": { "type": "integer", "minimum": 1 }
            }
          }
        }
      }
    }
  ]
}
