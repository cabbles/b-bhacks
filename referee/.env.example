PORT=8787
RPC_URL=
REFEREE_PRIVATE_KEY=
# Keeper: settles rounds and pays everyone automatically. Use its own key, never the referee key; keep a little ETH on it.
KEEPER_PRIVATE_KEY=
# Browser origins allowed to call the referee, comma-separated (your site). Empty allows any origin.
CORS_ORIGINS=
# Optional: where the keeper's event scan starts (defaults to deployBlock in shared/deployments.json),
# and the block range per eth_getLogs call (sepolia.base.org allows 200).
DEPLOY_BLOCK=
LOG_CHUNK=
POOL_ADDRESS=
# gemini: needs GEMINI_API_KEY (free key from aistudio.google.com). Picked automatically when the key is set.
# api: Anthropic API, needs MODEL_API_KEY. off: deterministic checks only.
MODEL_PROVIDER=gemini
GEMINI_API_KEY=
# Leave blank for the defaults (gemini-3.8-flash and gemini-3.5-flash-lite). Use two different models.
MODEL_NAME_A=
MODEL_NAME_B=
MODEL_API_KEY=
GITHUB_TOKEN=
# "Connect GitHub": a GitHub OAuth App (callback <referee>/auth/github/callback), and a 32-byte base64 key
# (openssl rand -base64 32) that encrypts stored sign-in tokens. GitHub tasks need all three.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
TOKEN_ENC_KEY=
# Where the GitHub sign-in sends people back to (defaults to web_url in shared/deployments.json)
WEB_URL=
ADMIN_KEY=
CANVAS_TOKEN=
CANVAS_ALLOWED_STAKERS=
# REFEREE_FIXTURES=1 serves every route from shared/fixtures
REFEREE_FIXTURES=
# Local dev only: accept POST /goals without checking the stake tx on chain
SKIP_STAKE_CHECK=
