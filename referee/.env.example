PORT=8787
RPC_URL=
REFEREE_PRIVATE_KEY=
POOL_ADDRESS=
# gemini: needs GEMINI_API_KEY (free key from aistudio.google.com). Picked automatically when the key is set.
# api: Anthropic API, needs MODEL_API_KEY. claude-cli: `claude -p` on a logged-in Claude account. off: deterministic checks only.
MODEL_PROVIDER=gemini
GEMINI_API_KEY=
# Leave blank for the defaults (gemini-3.8-flash and gemini-3.5-flash-lite). Use two different models.
MODEL_NAME_A=
MODEL_NAME_B=
MODEL_API_KEY=
GITHUB_TOKEN=
ADMIN_KEY=
CANVAS_TOKEN=
CANVAS_ALLOWED_STAKERS=
# REFEREE_FIXTURES=1 serves every route from shared/fixtures
REFEREE_FIXTURES=
# Local dev only: accept POST /goals without checking the stake tx on chain
SKIP_STAKE_CHECK=
# Public tunnel domain for scripts/run-live.sh (optional)
NGROK_URL=
